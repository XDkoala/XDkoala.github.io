---
import Base from '../layouts/Base.astro';
import AwardCard from './AwardCard.astro';
import { getContent } from '../data/content';
import { ui, rankOf, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const { person, interests, stats, courses, foundations, awards, projects } = getContent(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const prefix = lang === 'en' ? base + 'en/' : base;
const osc = awards.filter((a) => a.group === 'osc');
const oscFirst = osc.filter((a) => rankOf(a.level) === 1);
const oscSecond = osc.filter((a) => rankOf(a.level) === 2);
const oscThird = osc.filter((a) => rankOf(a.level) === 3);
const other = awards.filter((a) => a.group === 'other');
const mailIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';
const ghIcon = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.15-1.11-1.46-1.11-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.9.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>';
---
<Base lang={lang} title={t.siteTitle}>
  <main>
    <section id="about">
      <div class="hero">
        <canvas id="world" aria-hidden="true"></canvas>
        <div class="wrap hero-grid">
          <div>
            <span class="tagline" data-hero><i class="dot"></i>{t.hero.tagline}</span>
            <h1 data-split data-hero-name>{t.hero.h1}</h1>
            <div class="en" data-hero>{t.hero.sub}</div>
            <p class="meta" data-hero>{t.hero.meta}</p>
            <div class="mailbox" data-hero>
              <div class="mb-ic"><Fragment set:html={mailIcon} /><span>{t.hero.mailLabel}</span></div>
              <div class="mb-list">
                <div class="mb-row">
                  <a href={`mailto:${person.emailMain}`}><small>{t.hero.mailMain}</small>{person.emailMain}</a>
                  <button class="copy" type="button" data-copy={person.emailMain} aria-label={t.hero.copyMain}>{t.copy}</button>
                </div>
                <div class="mb-row">
                  <a href={`mailto:${person.emailSchool}`}><small>{t.hero.mailSchool}</small>{person.emailSchool}</a>
                  <button class="copy" type="button" data-copy={person.emailSchool} aria-label={t.hero.copySchool}>{t.copy}</button>
                </div>
              </div>
            </div>
            <div class="cta" data-hero>
              <a class="btn" data-magnet href={person.github} target="_blank" rel="noopener"><Fragment set:html={ghIcon} />GitHub</a>
              <a class="btn" data-magnet href="#projects">{t.hero.viewProjects}<span class="arrow">→</span></a>
            </div>
          </div>
          <div class="portrait" data-hero id="portrait">
            <div class="frame"><img src={`${base}${person.photo}`} alt={t.hero.photoAlt} fetchpriority="high" /></div>
            <a class="chip a" href="#education">GPA 3.93 / 4.00</a>
            <a class="chip r" href="#education">Rank 2 / 36</a>
            <a class="chip b" href="#about-detail">Embodied AI</a>
            <a class="chip c" href="#about-detail">Physical AI</a>
            <a class="chip d" href="#about-detail">VLA</a>
            <a class="chip e" href="#about-detail">World Models</a>
          </div>
        </div>
        <div class="scroll-hint" data-hero>SCROLL<i></i></div>
      </div>

      <div class="section" id="about-detail">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <div class="eyebrow">01 · About</div>
            <h2 class="h2">{t.about.heading}</h2>
          </div>
          <div class="about-grid">
            <div class="bio" data-reveal>
              {person.bio.map((p) => <p>{p}</p>)}
            </div>
            <div class="contact">
              <div class="ct" data-reveal>
                <a href={`mailto:${person.emailMain}`}>
                  <div class="ic"><Fragment set:html={mailIcon} /></div>
                  <div><small>{t.about.emailMain}</small><span>{person.emailMain}</span></div>
                </a>
                <button class="copy" type="button" data-copy={person.emailMain} aria-label={t.about.copyMain}>{t.copy}</button>
              </div>
              <div class="ct" data-reveal>
                <a href={`mailto:${person.emailSchool}`}>
                  <div class="ic"><Fragment set:html={mailIcon} /></div>
                  <div><small>{t.about.emailSchool}</small><span>{person.emailSchool}</span></div>
                </a>
                <button class="copy" type="button" data-copy={person.emailSchool} aria-label={t.about.copySchool}>{t.copy}</button>
              </div>
              <div class="ct" data-reveal>
                <a href={person.github} target="_blank" rel="noopener">
                  <div class="ic"><Fragment set:html={ghIcon} /></div>
                  <div><small>GitHub</small><span>github.com/{person.githubName}</span></div>
                </a>
              </div>
            </div>
          </div>
          <div class="subtitle" style="margin-top:72px" data-reveal>{t.about.interests}</div>
          <div class="interests" style="margin-top:0">
            {interests.map((it, i) => (
              <div class="card" data-reveal>
                <div class="no">0{i + 1}</div>
                <h3>{it.t}</h3>
                <p>{it.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="education" class="section alt">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div class="eyebrow">02 · Education &amp; Honors</div>
          <h2 class="h2">{t.edu.heading}</h2>
        </div>

        <div class="stats">
          {stats.map((s) => (
            <div class="stat" data-reveal>
              <div class="num"><span data-count={s.value} data-dec={s.dec}>{s.value.toFixed(s.dec)}</span><small>{s.suffix}</small></div>
              <p>{s.label}</p>
            </div>
          ))}
        </div>

        <div class="edu-grid">
          <div class="edu-card" data-reveal>
            <div class="subtitle">{t.edu.eduTitle}</div>
            <div class="t">{t.edu.school}</div>
            <div class="m">{t.edu.major}</div>
            <ul>
              {t.edu.items.map((x) => <li>{x}</li>)}
            </ul>
          </div>
          <div data-reveal>
            <div class="subtitle">{t.edu.courses}</div>
            {courses.map((c) => (
              <div class="course">
                <span>{c.n}</span><b>{c.s}</b>
                <div class="bar"><i style={`--p:${c.s / 100}`} data-p={c.s / 100}></i></div>
              </div>
            ))}
          </div>
        </div>

        <div class="subtitle" data-reveal>{t.edu.foundations}</div>
        <div class="foundations" style="margin-top:0;margin-bottom:96px">
          {foundations.map((f) => (
            <div class="card" data-reveal>
              <h4>{f.t}</h4>
              <p>{f.d}</p>
            </div>
          ))}
        </div>

        <div class="award-head" data-reveal>
          <div class="subtitle" style="margin-bottom:6px">{t.edu.awards}</div>
          <p class="lead">{t.edu.awardsLead}</p>
        </div>

        <div class="group-title" data-reveal>
          <h3>{t.edu.osc}</h3>
          <span class="mono">{t.edu.oscCount(oscFirst.length, oscSecond.length, oscThird.length)}</span>
        </div>
        <div class="bento">
          {oscFirst.map((a) => <AwardCard a={a} variant="feature" lang={lang} />)}
          {oscSecond.map((a) => <AwardCard a={a} variant="wide" lang={lang} />)}
          {oscThird.map((a) => <AwardCard a={a} variant="small" lang={lang} />)}
        </div>

        <div class="group-title" style="margin-top:72px" data-reveal>
          <h3>{t.edu.other}</h3>
          <span class="mono">{t.edu.otherCount(other.length)}</span>
        </div>
        <div class="trio">
          {other.map((a) => <AwardCard a={a} variant="small" lang={lang} />)}
        </div>
      </div>
    </section>

    <section id="projects" class="section">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div class="eyebrow">03 · Selected Projects</div>
          <h2 class="h2">{t.proj.heading}</h2>
          <p class="lead">{t.proj.lead}</p>
        </div>
        <div class="proj-list">
          {projects.map((p) => (
            <article class="proj" data-reveal>
              <div class="side">
                <div class="shot">
                  {p.cover.kind === 'video'
                    ? <video src={`${base}${p.cover.src}#t=0.1`} muted loop playsinline preload="metadata" data-autoplay></video>
                    : <img src={`${base}${p.cover.src}`} alt={t.proj.previewAlt(p.title)} loading="lazy" decoding="async" />}
                  <span class="no mono">{p.no}</span>
                </div>
                <dl>
                  <dt>{t.proj.nature}</dt><dd>{p.nature}</dd>
                  <dt>{t.proj.start}</dt><dd>{p.start}</dd>
                  <dt>{t.proj.status}</dt><dd>{p.status}</dd>
                </dl>
              </div>
              <div class="main">
                <h3>{p.title}</h3>
                <p class="short">{p.short}</p>
                <p class="sum">{p.summary}</p>
                <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
                <div class="contrib"><b>{t.proj.contrib}</b>{p.contribution[0]}</div>
                <div class="actions">
                  <a class="btn primary" href={`${prefix}projects/${p.slug}/`}>{t.proj.detail}<span class="arrow">→</span></a>
                  <a class="btn" href={p.repo} target="_blank" rel="noopener"><Fragment set:html={ghIcon} />{p.repoLabel}</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import gsap from 'gsap';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(pointer: fine)').matches;

  /* entrance */
  const chars = document.querySelectorAll('[data-hero-name] .ch');
  const heroEls = document.querySelectorAll('[data-hero]');
  if (!reduce) {
    const tl = gsap.timeline({ defaults: { ease: 'power4.out' }, delay: 0.1 });
    tl.set(heroEls, { opacity: 0 });
    tl.to(heroEls[0], { opacity: 1, y: 0, duration: 0.8 }, 0.1);
    tl.fromTo(chars, { yPercent: 110, opacity: 0, rotate: 8 }, { yPercent: 0, opacity: 1, rotate: 0, duration: 1.1, stagger: 0.09 }, 0.25);
    const rest = Array.from(heroEls).slice(1).filter((e) => e.id !== 'portrait');
    tl.fromTo(rest, { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9, stagger: 0.1 }, 0.6);
    tl.fromTo('#portrait', { opacity: 0, scale: 0.92, y: 30 }, { opacity: 1, scale: 1, y: 0, duration: 1.3 }, 0.4);
  }

  /* portrait tilt */
  const portrait = document.querySelector<HTMLElement>('#portrait');
  if (portrait && fine && !reduce) {
    const frame = portrait.querySelector('.frame');
    const rx = gsap.quickTo(frame, 'rotationX', { duration: 0.7, ease: 'power3' });
    const ry = gsap.quickTo(frame, 'rotationY', { duration: 0.7, ease: 'power3' });
    gsap.set(frame, { transformPerspective: 900 });
    const chips = Array.from(portrait.querySelectorAll<HTMLElement>('.chip')).map((el, i) => ({
      el,
      depth: 0.5 + (i % 3) * 0.35,
      x: gsap.quickTo(el, 'x', { duration: 0.8, ease: 'power3' }),
      y: gsap.quickTo(el, 'y', { duration: 0.8, ease: 'power3' }),
    }));
    addEventListener('pointermove', (e) => {
      const nx = e.clientX / innerWidth - 0.5;
      const ny = e.clientY / innerHeight - 0.5;
      ry(nx * 12);
      rx(-ny * 10);
      chips.forEach((c) => {
        const r = c.el.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const dist = Math.hypot(dx, dy);
        const pull = dist < 200 ? (1 - dist / 200) * 0.22 : 0;
        const bx = gsap.getProperty(c.el, 'x') as number;
        const by = gsap.getProperty(c.el, 'y') as number;
        const ox = r.left + r.width / 2 - bx;
        const oy = r.top + r.height / 2 - by;
        c.x(nx * 36 * c.depth + (e.clientX - ox) * pull);
        c.y(ny * 28 * c.depth + (e.clientY - oy) * pull);
      });
    });
    chips.forEach((c) => {
      c.el.addEventListener('pointerenter', () => gsap.to(c.el, { scale: 1.14, duration: 0.35, ease: 'back.out(2.5)' }));
      c.el.addEventListener('pointerleave', () => gsap.to(c.el, { scale: 1, duration: 0.4, ease: 'power3.out' }));
    });
    gsap.to(chips.map((c) => c.el), { yPercent: 28, duration: 2.4, repeat: -1, yoyo: true, ease: 'sine.inOut', stagger: 0.45 });
  }

  /* world-model canvas: a perceptual terrain that reacts to the pointer */
  const canvas = document.getElementById('world') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const mobile = innerWidth < 760;
  const COLS = mobile ? 26 : 56;
  const ROWS = mobile ? 16 : 26;
  let w = 0, h = 0, dpr = 1, t = 0, running = true;
  const mouse = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 };

  const resize = () => {
    dpr = Math.min(devicePixelRatio || 1, 2);
    const r = canvas.getBoundingClientRect();
    w = r.width; h = r.height;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  };
  resize();
  addEventListener('resize', () => { resize(); draw(); });
  addEventListener('pointermove', (e) => {
    const r = canvas.getBoundingClientRect();
    mouse.tx = (e.clientX - r.left) / r.width;
    mouse.ty = (e.clientY - r.top) / r.height;
  });

  const project = (X: number, Y: number, Z: number) => {
    const f = h * 0.85;
    const s = f / (Z + 1.1);
    return { x: w * 0.5 + X * s * 1.15, y: h * 0.34 + (1.05 - Y) * s * 0.9, s };
  };

  const height = (X: number, Z: number, mx: number, mz: number) => {
    const d2 = (X - mx) ** 2 + (Z - mz) ** 2;
    return Math.sin(X * 2.6 + t * 0.7) * 0.07 + Math.cos(Z * 2.1 - t * 0.55) * 0.07 + Math.sin((X + Z) * 3.4 + t) * 0.025 + 0.34 * Math.exp(-d2 / 0.07);
  };

  const draw = () => {
    ctx.clearRect(0, 0, w, h);
    mouse.x += (mouse.tx - mouse.x) * 0.06;
    mouse.y += (mouse.ty - mouse.y) * 0.06;
    const dy = Math.max(mouse.y - 0.34, 0.18);
    const mz = Math.min(3.4, Math.max(0, (1.05 * 0.9 * 0.85) / dy - 1.1));
    const mx = ((mouse.x - 0.5) * w) / ((h * 0.85) / (mz + 1.1) * 1.15);
    const scan = ((t * 0.35) % 1.4) * 2.8 - 0.3;
    const pts: { x: number; y: number; s: number; Z: number; hot: number }[][] = [];
    for (let j = 0; j < ROWS; j++) {
      const Z = (j / (ROWS - 1)) ** 1.5 * 3.4;
      const row = [];
      for (let i = 0; i < COLS; i++) {
        const X = (i / (COLS - 1) - 0.5) * 5.2;
        const Y = height(X, Z, mx, mz) * 1.4;
        const p = project(X, Y, Z);
        const hot = Math.max(0, 1 - Math.abs(Z - scan) / 0.22) + Math.max(0, 1 - Math.hypot(X - mx, Z - mz) / 0.7);
        row.push({ ...p, Z, hot: Math.min(1, hot) });
      }
      pts.push(row);
    }
    ctx.lineWidth = 1;
    for (let j = pts.length - 1; j >= 0; j--) {
      const fade = Math.max(0.05, 1 - pts[j][0].Z / 3.4);
      ctx.beginPath();
      pts[j].forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
      ctx.strokeStyle = `rgba(0,112,60,${0.05 + fade * 0.2})`;
      ctx.stroke();
      if (j < pts.length - 1) {
        ctx.beginPath();
        for (let i = 0; i < COLS; i += 2) {
          ctx.moveTo(pts[j][i].x, pts[j][i].y);
          ctx.lineTo(pts[j + 1][i].x, pts[j + 1][i].y);
        }
        ctx.strokeStyle = `rgba(0,112,60,${0.04 + fade * 0.12})`;
        ctx.stroke();
      }
      for (let i = 0; i < COLS; i++) {
        const p = pts[j][i];
        const r = (0.8 + p.hot * 2.4) * Math.min(1.4, p.s / (h * 0.5));
        ctx.beginPath();
        ctx.arc(p.x, p.y, Math.max(0.6, r), 0, 6.283);
        ctx.fillStyle = p.hot > 0.05 ? `rgba(17,179,107,${0.25 + p.hot * 0.7})` : `rgba(0,112,60,${0.12 + fade * 0.35})`;
        ctx.fill();
      }
    }
  };

  const loop = () => {
    if (!running) return;
    t += 0.016;
    draw();
    requestAnimationFrame(loop);
  };
  draw();
  if (!reduce) {
    requestAnimationFrame(loop);
    new IntersectionObserver(([e]) => {
      const was = running;
      running = e.isIntersecting && !document.hidden;
      if (running && !was) requestAnimationFrame(loop);
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      const was = running;
      running = !document.hidden;
      if (running && !was) requestAnimationFrame(loop);
    });
  }
</script>
